# --- Byte-compiled / cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
.eggs/
wheels/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets (never commit credentials) ---
.env
.env.*
!.env.example
*.pgpass
.pgpass
wrds_credentials*
*.pem
*.key
*credentials*.json
*token*.json

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Type checking / linting caches ---
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Logs ---
logs/
*.log

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Data: WRDS extracts and any other raw/licensed data must NEVER be committed ---
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.dta
*.sas7bdat
*.parquet
*.feather

# Blanket dataset-file rules (defense in depth, on top of the folder-specific
# rules above): no CSV/GZ file of any kind is tracked anywhere in this repo.
# As of the last audit, no legitimate tracked file uses these extensions —
# if one is ever needed (e.g. a small synthetic test fixture), add a
# specific `!path/to/file` exception rather than removing this rule.
*.csv
*.csv.gz
*.gz

# --- Reports / notebooks output (generated, not source) ---
reports/figures/*
!reports/figures/.gitkeep
reports/tables/*
!reports/tables/.gitkeep

# Data validation reports are regenerated by scripts/run_data_validation.py and
# may embed literal sample values (CUSIPs, tickers, prices, etc.) from the
# licensed WRDS extract — never commit them, matching data/raw's treatment.
reports/data_validation/*
!reports/data_validation/.gitkeep

# Same treatment for merge diagnostics: regenerated by
# scripts/run_data_processing.py, may embed aggregate stats derived from the
# licensed WRDS extract. MERGE_REPORT.md (git-tracked) carries the durable
# summary instead.
reports/data_processing/*
!reports/data_processing/.gitkeep

# Same treatment for feature-engineering diagnostics: regenerated by
# scripts/run_feature_engineering.py, derived from the licensed WRDS
# extract. The feature registry itself is pure metadata (formulas, column
# names, documentation) with no licensed data in it, so the JSON copy is
# explicitly kept — FEATURE_DICTIONARY.md is the prose version of the same
# thing. No CSV copy is kept, even though it's equally data-free, to keep
# the "no tracked CSV files anywhere" rule above unconditional.
reports/feature_engineering/*
!reports/feature_engineering/.gitkeep
!reports/feature_engineering/feature_registry.json

# Same treatment for modeling/backtest diagnostics: regenerated by
# scripts/run_modeling.py / scripts/run_backtest.py, derived from the
# licensed WRDS extract (out-of-sample predictions, portfolio returns,
# performance metrics). MODEL_REPORT.md (git-tracked) carries the durable
# summary instead, matching MERGE_REPORT.md / UNIT_AUDIT_REPORT.md.
reports/modeling/*
!reports/modeling/.gitkeep
reports/backtest/*
!reports/backtest/.gitkeep

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.iml

# --- Temporary files ---
*.tmp
*.temp
*~
*.bak
*.orig

# --- AI coding-agent local state (never part of the published repo) ---
.claude/
.cursor/
.aider*

# --- Internal planning / scratch (kept locally, not published) ---
# TASKS.md is a working task-tracker/changelog for this project's own
# development, not documentation intended for external readers of the
# published repo (DATA_DICTIONARY.md, MERGE_REPORT.md, FEATURE_DICTIONARY.md,
# UNIT_AUDIT_REPORT.md, and PLAN.md are the public-facing docs and remain
# tracked). Keep editing it locally; it just never gets committed.
TASKS.md

# --- Local assistant config (not part of the project) ---
CLAUDE.md
AGENTS.md
